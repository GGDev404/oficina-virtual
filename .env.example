# Copiar a ~/.config/oficina-virtual/.env con chmod 600. Nunca al repo.
CLICKUP_TOKEN=pk_...
# Solo si el token ve varios equipos de ClickUp:
# CLICKUP_TEAM_ID=
# Opcionales:
# OFICINA_NOMBRE=Tu nombre      (firma de los mensajes a los agentes)
# OFICINA_NOCHE_DIR=/ruta/a/noche (carpetas AAAA-MM-DD con resumen.md del turno nocturno)
